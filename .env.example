# =========================
# MySQL / RDS connection
# =========================
MYSQL_HOST=database-1.cluster-cn6wwckiqvwk.ap-east-1.rds.amazonaws.com
MYSQL_PORT=3306
MYSQL_USER=mysql_monitor
MYSQL_PASSWORD=ChangeMe_StrongPassword
MYSQL_DATABASE=
MYSQL_CONNECT_TIMEOUT=5
MYSQL_READ_TIMEOUT=30

# =========================
# Service schedule
# 1800 seconds = 30 minutes
# =========================
SERVICE_NAME=UG生产MySQL死锁慢SQL巡检
CHECK_INTERVAL_SECONDS=1800
RUN_ONCE=false
LOG_LEVEL=INFO

# =========================
# Alert thresholds
# =========================
LONG_TRX_SECONDS=60
PROCESSLIST_SLOW_SECONDS=10
LOCK_WAIT_ALERT_THRESHOLD=1

# New deadlock dedupe state. Persist /data volume.
DEADLOCK_STATE_FILE=/data/last_deadlock.sha256

# =========================
# Optional mysql.slow_log table check
# Requires slow_query_log=ON and log_output=TABLE
# =========================
ENABLE_SLOW_LOG_TABLE=false
SLOW_LOG_LOOKBACK_MINUTES=30
SLOW_LOG_LIMIT=20

# =========================
# Optional performance_schema digest summary
# Default false to avoid repeated noise.
# =========================
ENABLE_DIGEST_SUMMARY=false
DIGEST_AVG_SECONDS=1.0
DIGEST_LIMIT=10

# =========================
# Telegram group alert
# Send only when findings exist.
# HTML report uses parse_mode=HTML.
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-4974599682
TELEGRAM_DISABLE_WEB_PAGE_PREVIEW=true
REPORT_MAX_CHARS=3800

# Optional generic webhook. Receives JSON with html_report and findings.
ALERT_WEBHOOK_URL=
